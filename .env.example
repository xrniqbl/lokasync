# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Set these in your hosting provider (Vercel / Netlify / etc.) for production.
# Locally, copy this file to .env.local and fill in the values.
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Supabase Edge Function secrets ───────────────────────────────────────────
# Set with:  npx supabase secrets set KEY=value
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)
#
# Payments (Midtrans Snap). Use sandbox keys while MIDTRANS_IS_PRODUCTION=false.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
#
# Founder panel access — comma-separated email allowlist.
ADMIN_EMAILS=founder@example.com
#
# Transactional email (invites, payment receipts, renewal reminders, email OTP).
# Without RESEND_API_KEY the email OTP second factor returns 503.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
INVITE_FROM_EMAIL=LokaSync <noreply@yourdomain.com>
