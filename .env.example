# ── Supabase (browser client) ───────────────────────────────────────────────
# Find these in your Supabase dashboard:
#   Project Settings → API → Project URL  (the ref is the subdomain)
#   Project Settings → API → Project API keys → anon public
# The anon key is safe to ship to the browser (RLS enforces access control).
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Supabase Edge Function Secrets (server-side only) ────────────────────────
# Set these via: npx supabase secrets set KEY=value --project-ref <ref>

# CORS — comma-separated list of allowed frontend origins
# Example: https://lokasync.app,http://localhost:5173
ALLOWED_ORIGINS=https://lokasync.app

# Admin access — comma-separated emails that can access /admin panel
ADMIN_EMAILS=your-email@example.com

# Midtrans payment gateway (set MIDTRANS_IS_PRODUCTION=true for live)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Brevo email OTP (optional — enables email 2FA method)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@lokasync.com

# ── Optional: dev-only LLM review scripts (Python) ──────────────────────────
# Used by main.py / zhipu_service.py. Not part of the running web app.
# Rotate any key that was previously committed to git.
ZHIPUAI_API_KEY=
